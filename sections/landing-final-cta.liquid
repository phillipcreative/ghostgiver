<section class="gg-landing gg-cta">
  <img
    class="gg-silhouettes gg-cta__silhouettes"
    src="{{ 'landing-silhouettes.svg' | asset_url }}"
    alt=""
    width="1440"
    height="569"
    loading="lazy"
  >
  <div class="gg-cta__inner">
    <p class="gg-kicker gg-cta__kicker">{{ section.settings.kicker }}</p>
    <h2 class="gg-cta__title">{{ section.settings.heading }}</h2>
    <p class="gg-cta__text">{{ section.settings.text }}</p>
    <div class="gg-cta__action">
      <a class="gg-btn gg-btn--navy" href="{{ section.settings.button_link | default: '/collections/gifts' }}">{{ section.settings.button_label }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Landing final CTA",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Ghost someone...the good way"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to Make Someone’s Day?"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Choose a gift, add a personal message, and we'll ship it anonymously without revealing who sent it."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Choose a Gift"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ]
}
{% endschema %}

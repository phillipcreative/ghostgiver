{% if section.settings.image != blank %}
  {% assign experience_image = section.settings.image | image_url: width: 2000 %}
{% else %}
  {% assign experience_image = 'landing-experience-photo.jpg' | asset_url %}
{% endif %}

<section
  id="gg-experience"
  class="gg-landing gg-experience"
  style="--gg-experience-image: url('{{ experience_image }}');"
>
  <div class="gg-experience__inner">
    <p class="gg-kicker gg-experience__kicker">{{ section.settings.kicker }}</p>
    <h2 class="gg-experience__title">{{ section.settings.heading }}</h2>
    <p class="gg-experience__text">{{ section.settings.text }}</p>
    <div class="gg-experience__action">
      <a class="gg-btn" href="{{ section.settings.button_link | default: '/collections/gifts' }}">
        <img src="{{ 'landing-icon-package.svg' | asset_url }}" alt="" width="18" height="18">
        {{ section.settings.button_label }}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Landing experience",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "The Experience"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Imagine Their Surprise"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "An unexpected gift arrives in the mail. They open it to discover a thoughtful surprise from someone who chose to remain anonymous. Just imagine the smile on their face and the curiosity about who sent it."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Choose a Gift"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background photo"
    }
  ]
}
{% endschema %}
